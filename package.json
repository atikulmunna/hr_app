{
  "name": "hris-platform",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "description": "Multi-tenant HRIS platform with mobile attendance and verification",
  "scripts": {
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f postgres",
    "backend:dev": "pnpm --filter @hris/backend start:dev",
    "backend:migrate": "pnpm --filter @hris/backend migration:run",
    "backend:seed": "pnpm --filter @hris/backend seed",
    "format": "prettier --write \"backend/src/**/*.ts\" \"web/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"backend/src/**/*.ts\" \"web/src/**/*.{ts,tsx}\"",
    "lint": "eslint backend/src web/src",
    "lint:fix": "eslint backend/src web/src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.1"
  }
}
