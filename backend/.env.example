# Copy to backend/.env for local development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hris

# Owner / migration role (superuser). Used by migrations and seeding.
DB_USER=hris
DB_PASSWORD=hris_dev_pw

# Application runtime role (non-superuser, subject to row-level security).
APP_DB_USER=hris_app
APP_DB_PASSWORD=hris_app_pw

# Keycloak base URL. Token issuers must sit under <KEYCLOAK_URL>/realms/.
KEYCLOAK_URL=http://localhost:8080
