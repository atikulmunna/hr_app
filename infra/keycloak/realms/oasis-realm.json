{
  "realm": "oasis",
  "enabled": true,
  "displayName": "Oasis Corp",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "hris-web",
      "name": "HRIS Web Console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "hris-mobile",
      "name": "HRIS Mobile App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["com.oasis.hris://auth/*", "http://localhost/*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "roles": {
    "realm": [
      { "name": "employee", "description": "Self-service employee" },
      { "name": "manager", "description": "Manager self-service" },
      { "name": "hr_admin", "description": "HR administrator" },
      { "name": "recruiter", "description": "Recruiter" },
      { "name": "tenant_admin", "description": "Tenant administrator" },
      { "name": "auditor", "description": "Auditor and reviewer" }
    ]
  },
  "users": [
    {
      "username": "demo.employee",
      "enabled": true,
      "email": "demo.employee@oasis.example",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Employee",
      "credentials": [
        { "type": "password", "value": "demo123", "temporary": false }
      ],
      "realmRoles": ["employee"]
    },
    {
      "username": "demo.admin",
      "enabled": true,
      "email": "demo.admin@oasis.example",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["hr_admin"]
    },
    {
      "username": "demo.manager",
      "enabled": true,
      "email": "demo.manager@oasis.example",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Manager",
      "credentials": [
        { "type": "password", "value": "manager123", "temporary": false }
      ],
      "realmRoles": ["manager"]
    },
    {
      "username": "demo.owner",
      "enabled": true,
      "email": "demo.owner@oasis.example",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Owner",
      "credentials": [
        { "type": "password", "value": "owner123", "temporary": false }
      ],
      "realmRoles": ["tenant_admin"]
    }
  ]
}
